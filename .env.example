# ── Server-side (never exposed to the browser) ───────────────────────────────
# NestJS API base URL (e.g. http://localhost:3030/api/v1.0/)
BOG_API_BASE_URL="http://localhost:3030/api/v1.0/"

# Optional: Logtail source token for server-side logging
LOGTAIL_SOURCE_TOKEN=

# ── Client-side (NEXT_PUBLIC_ prefix = visible in the browser) ───────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth provider client IDs (public — used in OAuth redirect URIs)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# OAuth callback URL — must match your provider config
# e.g. http://localhost:3000/auth/sign-in
NEXT_PUBLIC_REDIRECT_URI="http://localhost:3000/auth/sign-in"

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Shared ────────────────────────────────────────────────────────────────────
NODE_ENV=development
