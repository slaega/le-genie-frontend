# ── Server-side (jamais exposé au navigateur) ─────────────────────────────────
# URL interne vers NestJS — trailing slash obligatoire
API_BASE_URL="http://localhost:3030/api/"

# Logtail (optionnel)
LOGTAIL_SOURCE_TOKEN=

# ── Client-side (NEXT_PUBLIC_ = visible dans le navigateur) ───────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth — IDs publics (créer sur Google Console / GitHub Developer Settings)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# URL de callback OAuth — doit correspondre à la config du provider
NEXT_PUBLIC_REDIRECT_URI="http://localhost:3000/fr/auth/sign-in"

# Analytics (optionnel)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Shared ────────────────────────────────────────────────────────────────────
NODE_ENV=development
