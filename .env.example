# ── Server-side (jamais exposé au navigateur) ─────────────────────────────────
# URL interne vers NestJS — trailing slash obligatoire
API_BASE_URL="http://localhost:3030/api/"

# Logtail (optionnel)
LOGTAIL_SOURCE_TOKEN=

# ── Client-side (NEXT_PUBLIC_ = visible dans le navigateur) ───────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth — IDs publics (créer sur la console de chaque provider)
# Google  → https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# GitHub  → https://github.com/settings/developers
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Microsoft → https://portal.azure.com → App registrations
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# URL de callback OAuth — doit correspondre à la config du provider
# En prod: https://votre-domaine.com/api/auth/callback
NEXT_PUBLIC_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# Analytics (optionnel)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Shared ────────────────────────────────────────────────────────────────────
NODE_ENV=development
